# Copy to .env and fill in. Never commit .env.
F2W_PROVIDER=openai              # openai | anthropic

OPENAI_API_KEY=
F2W_OPENAI_MODEL=gpt-6.1-sol     # e.g. gpt-6-sol, gpt-6-luna, gpt-6-astra
F2W_OPENAI_REASONING_EFFORT=high # none | minimal | low | medium | high | xhigh | max

ANTHROPIC_API_KEY=
F2W_CLAUDE_MODEL=claude-opus-5-5
F2W_CLAUDE_EFFORT=high

# Any OpenAI-compatible server with vision (F2W_PROVIDER=compatible). Examples — check each
# provider's docs for the exact base URL and model id:
#   OpenRouter:        https://openrouter.ai/api/v1       model e.g. qwen/qwen3-vl-...
#   Yandex AI Studio:  https://llm.api.cloud.yandex.net/v1 model gpt://<folder-id>/<model>
#   vLLM (own GPU):    http://localhost:8000/v1
#   Ollama:            http://localhost:11434/v1
F2W_COMPATIBLE_BASE_URL=
F2W_COMPATIBLE_API_KEY=
F2W_COMPATIBLE_MODEL=
F2W_COMPATIBLE_STRICT=true       # false if the server lacks strict JSON Schema support
F2W_COMPATIBLE_LABEL=compatible  # shown in reports, e.g. openrouter-qwen

# Optional second reader for verification (Yandex Vision OCR)
F2W_YANDEX_API_KEY=
F2W_YANDEX_FOLDER_ID=

# Self-review previews: auto (LibreOffice or Word) | none
F2W_PREVIEW=auto
