{
  "name": "copeeq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src tests build.mjs eslint.config.js",
    "format:check": "prettier --check src/**/*.js tests/*.mjs build.mjs eslint.config.js",
    "format": "prettier --write src/**/*.js tests/*.mjs build.mjs eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
